{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "mutations.ts", "omp-extension.ts", "ompExtension.check.ts", "../release/**/*.ts"]
}
